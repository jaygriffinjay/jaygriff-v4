// Design doc for the database. Keep in sync with schema.ts.

// Shared by every content type. Posts need nothing more; other types add a 1:1 detail table below.
Table content {
  id              text      [pk]
  slug            text      [unique, not null]
  type            text      [not null, note: 'post | link | quote | comment | release | artifact | image']
  status          text      [not null, default: 'draft']
  title           text      [not null]
  description     text
  body            text      [note: 'markdown / MDX']
  format          text      [not null, default: 'md', note: 'md | mdx | component; component = body is a TSX file in the repo']
  component_key   text      [note: 'registry key for the TSX body; required when format = component']
  content_hash    text
  authors         text
  authorship      text      [not null, default: 'ai-assisted', note: 'human | ai-assisted | ai-generated; only human and ai-generated get a badge']
  authorship_note text      [note: 'free-text story of how it was made']
  tags            text
  project_id      text      [ref: > projects.id]
  published_at    text      [note: 'when it went live; null until published. Feeds sort by this']
  revised_at      text      [note: 'set by hand for meaningful updates; shown to readers and used for og modified_time']
  created_at      text      [not null]
  updated_at      text      [not null]

  indexes {
    project_id [name: 'idx_content_project_id']
    published_at
  }
}

Table content_links {
  content_id  text  [pk, ref: - content.id]
  target_url   text  [not null, note: 'the page being linked to']
  target_title text  [note: 'that page\'s title; my own title is content.title']
  via_url      text  [note: 'where I found it']
  via_name     text  [note: 'who or what showed it to me, e.g. Hacker News']
}

Table content_quotes {
  content_id  text  [pk, ref: - content.id]
  quote       text  [not null]
  author      text  [note: 'who said it']
  source_url  text  [note: 'optional; spoken quotes may have none']
  source_title text
  via_url     text
  via_name    text
}

Table content_comments {
  content_id      text  [pk, ref: - content.id]
  url             text  [not null, note: 'permalink to my comment']
  thread_title    text
  thread_url      text
  reply_to_text   text  [note: 'the comment I replied to, copied']
  reply_to_author text
  reply_to_url    text
}

// Notes live in the body; project comes from content.project_id
Table content_releases {
  content_id   text  [pk, ref: - content.id]
  version      text  [note: 'display label, e.g. 0.4.0 or "Beta 2"']
  release_url  text  [note: 'GitHub release page; null for private repos']
}

// Self-contained HTML; always served sandboxed. Screenshot is an asset with role thumbnail
Table content_artifacts {
  content_id  text     [pk, ref: - content.id]
  html        text     [not null, note: 'the whole file']
}

TableGroup content_types {
  content
  content_links
  content_quotes
  content_comments
  content_releases
  content_artifacts
}

// Multi-file code blocks; single snippets stay as markdown fences in the body
Table code_blocks {
  id          text  [pk]
  content_id  text  [ref: > content.id, note: 'owning post; null if standalone']
  title       text  [note: 'optional caption']
  source_url  text  [note: 'repo the files came from']
  created_at  text  [not null]
  updated_at  text  [not null]
}

Table code_block_files {
  id            text     [pk]
  code_block_id text     [not null, ref: > code_blocks.id]
  position      integer  [not null, note: 'tab / explorer order']
  path          text     [note: 'e.g. src/app/page.tsx; drives tab label and inferred language']
  language      text     [note: 'Shiki id; overrides inference from path']
  content       text     [not null]

  indexes {
    (code_block_id, position) [unique]
    (code_block_id, path) [unique]
  }
}

TableGroup code {
  code_blocks
  code_block_files
}

Table projects {
  id          text      [pk]
  slug        text      [unique, not null]
  title       text      [not null]
  tagline     text
  description text
  kind        text      [not null, default: 'project', note: 'experiment | project; experiments are exploratory and may be abandoned']
  status      text      [not null, default: 'draft']
  icon        text      [note: 'lucide icon name; fallback when there is no logo asset']
  app_href    text
  repo_url    text
  demo_url    text
  video_url   text
  tags        text
  sort_order  integer   [not null, default: 0]
  created_at  text      [not null]
  updated_at  text      [not null]
}

// All images/video for content and projects. Exactly one of project_id / content_id is set.
// Also: unique (content_id, role) and (project_id, role) where role in (thumbnail, hero, logo).
Table assets {
  id          integer  [pk, increment]
  project_id  text     [ref: > projects.id]
  content_id  text     [ref: > content.id]
  url         text     [not null]
  kind        text     [not null, default: 'image', note: 'image | video']
  role        text     [not null, note: 'thumbnail | hero | logo | gallery']
  alt         text     [note: 'required for images in practice']
  width       integer
  height      integer
  sort_order  integer  [not null, default: 0, note: 'order within gallery']
  created_at  text     [not null, default: `datetime('now')`]

  indexes {
    project_id
    content_id
  }
}

Table tools {
  id          text      [pk]
  section     text      [not null]
  title       text      [not null]
  logo        text      [not null]
  description text
  note        text
  status      text      [not null, default: 'active']
  invert      integer   [not null, default: 0, note: 'boolean (0/1)']
  sort_order  integer   [not null, default: 0]
  created_at  text      [not null]
  updated_at  text      [not null]

  indexes {
    (section, sort_order) [name: 'idx_tools_section']
  }

  Note: 'Standalone; backs a single hand-managed page'
}
