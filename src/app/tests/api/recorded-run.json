    {
      "title": "Same path again",
      "note": "The database's unique (parent_id, slug) index rejects it.",
      "expect": 409,
      "request": {
        "method": "POST",
        "path": "/api/content",
        "auth": true,
        "body": {
          "parentId": "fa8f9e44-0824-43db-8e1f-b3934b02b17b",
          "slug": "scratch-write-test",
          "type": "post",
          "title": "Again"
        }
      },
      "response": {
        "status": 409,
        "body": {
          "error": {
            "message": "UNIQUE constraint failed: content.parent_id, content.slug"
          }
        }
      }
    },
