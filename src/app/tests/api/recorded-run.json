  "steps": [
    {
      "title": "Write without a token",
      "note": "Writes need a bearer token. Reads don't.",
      "expect": 401,
      "request": {
        "method": "POST",
        "path": "/api/content",
        "auth": false,
        "body": {}
      },
      "response": {
        "status": 401,
        "body": {
          "error": {
            "message": "Unauthorized"
          }
        }
      }
    },
    {
      "title": "Invalid slug",
      "note": "Input is validated with zod before anything reaches the database.",
      "expect": 400,
      "request": {
        "method": "POST",
        "path": "/api/content",
        "auth": true,
        "body": {
          "slug": "Bad Slug",
          "type": "post",
          "title": "x"
        }
      },
      "response": {
        "status": 400,
        "body": {
          "error": {
            "message": "Invalid body",
            "issues": [
              {
                "origin": "string",
                "code": "invalid_format",
                "format": "regex",
                "pattern": "/^[a-z0-9]+(?:-[a-z0-9]+)*$/",
                "path": [
                  "slug"
                ],
                "message": "Use lowercase letters, numbers and single hyphens"
              }
            ]
          }
        }
      }
    },
    {
      "title": "Create a draft post",
      "note": "Under the /posts section. path is derived from the parent's path plus the slug.",
      "expect": 201,
      "request": {
        "method": "POST",
        "path": "/api/content",
        "auth": true,
        "body": {
          "parentId": "fa8f9e44-0824-43db-8e1f-b3934b02b17b",
          "slug": "scratch-write-test",
          "type": "post",
          "title": "Scratch"
